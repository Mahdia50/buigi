{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "data/**,public/assets/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js?__path=/api/$1"
    },
    {
      "source": "/_serverFn/(.*)",
      "destination": "/api/index.js?__path=/_serverFn/$1"
    },
    {
      "source": "/((?!assets/|static/|css/|js/|images/|image-cache|image-cache-proxy|data/|api/|_serverFn/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
